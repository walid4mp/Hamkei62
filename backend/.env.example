DATABASE_URL=postgresql://user:password@localhost:5432/socialnova?schema=public
JWT_SECRET=change-this-in-production
PORT=4000
CORS_ORIGIN=*
APP_URL=http://localhost:4000
# LiveKit Cloud or a self-hosted LiveKit server (required for real audio/video/screen share)
# Example URL: wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STORAGE_UPLOAD_URL=
STORAGE_PUBLIC_URL=
# Durable production media storage (Render filesystem is ephemeral)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: comma-separated extra admin emails. Developer seed accounts with role=DEVELOPER are admins automatically.
ADMIN_EMAILS=

# NovaCoin economy. Keep DEMO only for local/testing; production must verify Google Play/App Store purchases server-side.
IAP_VERIFICATION_MODE=
NOVA_COIN_CREATOR_SHARE=0.70
NOVA_COIN_WITHDRAWAL_FEE=0.10
